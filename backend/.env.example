# External PostgreSQL/Neon connection string. Use a restricted worker role.
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
FLOODML_MODEL_DIR=/models

# S3-compatible object storage credentials.
S3_ENDPOINT_URL=https://s3.us-east-1.wasabisys.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Resend flood alert delivery.
RESEND_API_KEY=
RESEND_ALERTS_FROM=alerts@floodmark.tech
PUBLIC_APP_URL=http://localhost:5173
NOTIFICATION_UNSUBSCRIBE_SECRET=

# Limits are per worker process.
CAMERA_BASE_URL=https://511ga.org/map/Cctv
DOWNLOAD_CONCURRENCY=300
S3_UPLOAD_CONCURRENCY=32
INFERENCE_CONCURRENCY=4
DATABASE_CONCURRENCY=16
DATABASE_POOL_SIZE=16
MAX_RESPONSE_BYTES=8388608
MAX_INFLIGHT_BYTES=536870912
REQUEST_TIMEOUT_SECONDS=20
ARQ_MAX_TRIES=3
ARQ_RETRY_DELAY_SECONDS=15
ARQ_RESULT_TTL_SECONDS=900
DEBUG=false

# Set true only when an immediate capture cycle is wanted on scheduler startup.
SCHEDULER_RUN_AT_STARTUP=false

# Alert decisions (see README "Behavior"). Blocklist entries are 511GA source camera IDs.
ALERT_STREAK_FRAMES=3
ALERT_BLOCKLIST=11372,17397,13750,13417,17356,13536,14256
ALERT_BASELINE_DAYS=7
ALERT_BASELINE_MIN_FRAMES=24
ALERT_BASELINE_MARGIN=0.10
ALERT_REQUIRE_RAIN=true
ALERT_MIN_RAIN_MM=1.0
ALERT_RAIN_WINDOW_HOURS=6
ALERT_STORM_STREAK_FRAMES=2
ALERT_FAST_POLL_SECONDS=60
# 511GA snapshots refresh slower than every 3 minutes, so fast re-polls are off by default.
ALERT_FAST_POLL_MAX=0
WEATHER_TIMEOUT_SECONDS=5
