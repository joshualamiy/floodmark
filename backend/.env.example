# External PostgreSQL/Neon connection string. Use a restricted worker role.
DATABASE_URL=
REDIS_URL=redis://redis:6379/0

# Cloudflare R2 S3-compatible API credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Limits are per worker process.
CAMERA_BASE_URL=https://511ga.org/map/Cctv
DOWNLOAD_CONCURRENCY=300
R2_UPLOAD_CONCURRENCY=32
INFERENCE_CONCURRENCY=4
DATABASE_CONCURRENCY=16
DATABASE_POOL_SIZE=16
MAX_RESPONSE_BYTES=8388608
MAX_INFLIGHT_BYTES=536870912
REQUEST_TIMEOUT_SECONDS=20
ARQ_MAX_TRIES=3
ARQ_RETRY_DELAY_SECONDS=15
ARQ_RESULT_TTL_SECONDS=900
DEBUG=false

# Set true only when an immediate capture cycle is wanted on scheduler startup.
SCHEDULER_RUN_AT_STARTUP=false
