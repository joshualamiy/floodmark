# data, weights and secrets never go in git (the root .gitignore covers these too)
data/
models/
.env
*.onnx
*.keras
*.h5
*.tflite
*.npy
*.npz

# tensorboard runs and job logs
logs/

# reports: only text files and metric charts are tracked.
# anything that shows dataset images (sample grids, heatmaps, errors.html)
# stays local because the repo is public and some sources are restricted.
/reports/*
!/reports/*.md
!/reports/*.csv
!/reports/*.json
!/reports/figures/

__pycache__/
.pytest_cache/
.ruff_cache/

# docs stay local
docs/
